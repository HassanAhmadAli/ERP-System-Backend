// todo: remove the customer from the invoices , make sales invoices annonymous
// todo: make decision, to include or not to include orders with invoices
generator client {
  provider     = "prisma-client"
  output       = "../src/prisma/generated/prisma-client"
  moduleFormat = "cjs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

//// enums
//////////////////////////
//// Testing Ground
enum LoyaltyReason {
  PURCHASE
  REDEMPTION
  ADJUSTMENT
}

//////////////////////////

enum UserRole {
  CUSTOMER
  CASHIER
  STORE_MANAGER
  ACCOUNTANT
  WAREHOUSE_WORKER
}

enum ProductImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AdPlacement {
  HOME
  CHECKOUT
  SIDEBAR
}

enum InvoiceStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountScope {
  GLOBAL
  CATEGORY
  PRODUCT
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum NotificationTargetType {
  USER
  ROLE
  ALL
}

//// Enums

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  fullNameAr   String?
  email        String   @unique
  phoneNumber  String?
  passwordHash String   @map("password")
  nationalId   String   @unique
  role         UserRole
  isActive     Boolean  @default(true)
  language     String   @default("en")

  isVerified                Boolean   @default(false)
  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  // relations
  productPhotos ProductPhoto[]
  employee      Employee?

  customer               Customer?
  auditLogs              AuditLog[]
  sentNotifications      Notification[]          @relation("SentBy")
  notificationRecipients NotificationRecipient[]
  recordedExpenses       Expense[]
  createdDiscounts       Discount[]
  productImportJobs      ProductImportJob[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?

  @@index([email, role, id])
}

model Employee {
  id         Int     @id @default(autoincrement())
  userId     Int     @unique
  jobTitle   String
  jobTitleAr String?

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  processedInvoices SalesInvoice[]    @relation("Cashier")
  recordedPurchases PurchaseInvoice[] @relation("Accountant")
}

model Customer {
  id            Int     @id @default(autoincrement())
  userId        Int     @unique
  address       String?
  addressAr     String?
  loyaltyPoints Int     @default(0)
  totalSpent    Decimal @default(0) @db.Decimal(12, 2)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  salesInvoices SalesInvoice[]
  orders        Order[]

  discounts          Discount[]
  loyaltyRedemptions LoyaltyRedemption[]
}

//// Products

model Category {
  id            Int     @id @default(autoincrement())
  name          String  @unique
  nameAr        String?
  description   String?
  descriptionAr String?
  imageUrl      String?
  storedFileId  String? @unique

  storedFile StoredFile? @relation(fields: [storedFileId], references: [id])
  products   Product[]
  discounts  Discount[]
}

model Supplier {
  id         Int     @id @default(autoincrement())
  fullName   String
  fullNameAr String?
  phone      String?
  email      String?
  address    String?
  addressAr  String?

  products         Product[]
  purchaseInvoices PurchaseInvoice[]
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  nameAr          String?
  description     String?
  descriptionAr   String?
  barcode         String   @unique
  purchasePrice   Decimal  @db.Decimal(12, 2)
  sellingPrice    Decimal  @db.Decimal(12, 2)
  quantityInStock Int
  minQuantity     Int
  categoryId      Int
  supplierId      Int
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  orderItems    OrderItem[]
  productPhotos ProductPhoto[]
  discounts     Discount[]
}

// Sales & Invoicing

model SalesInvoice {
  id                Int  @id @default(autoincrement())
  cashierId         Int
  customerId        Int?
  appliedDiscountId Int?

  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  cashier  Employee   @relation("Cashier", fields: [cashierId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  items    SaleItem[]

  appliedDiscount Discount? @relation(fields: [appliedDiscountId], references: [id])
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
}

model PurchaseInvoice {
  id           Int           @id @default(autoincrement())
  supplierId   Int
  accountantId Int
  total        Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(PENDING)
  invoiceDate  DateTime
  createdAt    DateTime      @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  accountant Employee @relation("Accountant", fields: [accountantId], references: [id])

  items PurchaseItem[]
}

model PurchaseItem {
  id         Int       @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity   Int
  unitCost   Decimal   @db.Decimal(12, 2)
  subtotal   Decimal   @db.Decimal(12, 2)
  // todo: 
  expiryDate DateTime?

  purchase PurchaseInvoice @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
}

model Order {
  id                Int  @id @default(autoincrement())
  customerId        Int
  appliedDiscountId Int?

  subtotal Decimal @db.Decimal(12, 2)

  deliveryAddress   String?
  deliveryAddressAr String?
  status            OrderStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer        Customer    @relation(fields: [customerId], references: [id])
  appliedDiscount Discount?   @relation(fields: [appliedDiscountId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// Discounts & Loyalty

model Discount {
  id              Int           @id @default(autoincrement())
  name            String
  nameAr          String?
  type            DiscountType
  value           Decimal       @db.Decimal(12, 2)
  scope           DiscountScope
  maxInvoiceValue Decimal       @default(0) @db.Decimal(12, 2)
  maxUses         Int?
  usedCount       Int           @default(0)
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean       @default(true)
  createdById     Int
  productId       Int?
  categoryId      Int?
  customerId      Int?

  createdAt DateTime @default(now())

  createdBy          User                @relation(fields: [createdById], references: [id])
  product            Product?            @relation(fields: [productId], references: [id])
  category           Category?           @relation(fields: [categoryId], references: [id])
  customer           Customer?           @relation(fields: [customerId], references: [id])
  salesInvoices      SalesInvoice[]
  orders             Order[]
  loyaltyRedemptions LoyaltyRedemption[]
}

model LoyaltyDiscountOffer {
  id            String       @id @default(uuid())
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  pointsCost    Int
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  maxUses       Int          @default(1)
  validityDays  Int          @default(7)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  redemptions LoyaltyRedemption[]
}

model LoyaltyRedemption {
  id          String   @id @default(uuid())
  customerId  Int
  offerId     String
  discountId  Int
  pointsSpent Int
  redeemedAt  DateTime @default(now())

  customer Customer             @relation(fields: [customerId], references: [id])
  offer    LoyaltyDiscountOffer @relation(fields: [offerId], references: [id])
  discount Discount             @relation(fields: [discountId], references: [id])
}

// Notifications

model Notification {
  id         Int                    @id @default(autoincrement())
  senderId   Int
  title      String
  titleAr    String?
  body       String
  bodyAr     String?
  targetType NotificationTargetType
  targetRole UserRole?
  sentAt     DateTime               @default(now())

  sender     User                    @relation("SentBy", fields: [senderId], references: [id])
  recipients NotificationRecipient[]
}

model Advertisement {
  id            Int         @id @default(autoincrement())
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  imageUrl      String?
  linkUrl       String?
  placement     AdPlacement @default(HOME)
  isActive      Boolean     @default(true)
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// used for storing one row, hoding the loyality policy of the store
model LoyaltyPolicy {
  id                Int      @id @default(1)
  pointsPerCurrency Decimal  @default(1) @db.Decimal(10, 4)
  currencyPerPoint  Decimal  @default(1) @db.Decimal(10, 4)
  updatedAt         DateTime @updatedAt
}

model ProductImportJob {
  id           Int                 @id @default(autoincrement())
  uploadedById Int
  fileName     String
  fileNameAr   String?
  status       ProductImportStatus @default(PENDING)
  totalRows    Int                 @default(0)
  successCount Int                 @default(0)
  errorCount   Int                 @default(0)
  errors       Json?
  createdAt    DateTime            @default(now())
  completedAt  DateTime?

  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

model NotificationRecipient {
  id             Int       @id @default(autoincrement())
  notificationId Int
  userId         Int
  isRead         Boolean   @default(false)
  readAt         DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

// Audit & Logging

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String
  entity      String
  entityId    String
  oldValue    Json?
  newValue    Json?
  performedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Expense {
  id            Int      @id @default(autoincrement())
  recordedById  Int
  description   String
  descriptionAr String?
  category      String
  categoryAr    String?
  amount        Decimal  @db.Decimal(12, 2)
  expenseDate   DateTime
  createdAt     DateTime @default(now())

  recordedBy User @relation(fields: [recordedById], references: [id])
}

////
model errors {
  id    Int  @id @default(autoincrement())
  error Json @db.JsonB
}

model ProductPhoto {
  id           Int    @id @default(autoincrement())
  storedFileId String

  creatorId Int
  productId Int

  storedFile StoredFile @relation(fields: [storedFileId], references: [id])
  creator    User       @relation(fields: [creatorId], references: [id])
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId])
}

model StoredFile {
  id           String @id @unique
  originalname String
  mimetype     String
  path         String @unique
  size         Int

  productPhotos ProductPhoto[]
  category      Category?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
